{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs && node -e \"const fs=require('fs'); fs.mkdirSync('dist/scripts', {recursive:true}); fs.copyFileSync('server/scripts/printRawZpl.ps1', 'dist/scripts/printRawZpl.ps1');\"",
    "start": "node dist/server.cjs",
    "build:exe": "npm run build && electron-builder --win --config electron-builder.json",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bwip-js": "^3.2.3",
    "@types/cors": "^2.8.19",
    "@types/jsbarcode": "^3.11.4",
    "@vitejs/plugin-react": "^5.0.4",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
